{
  "name": "caldav-telegram-bot-v2",
  "version": "0.1.0",
  "description": "A bot that posts forthcomming events to a telegram channel",
  "main": "dist/main.mjs",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "start": "node --env-file-if-exists=.env src/main.mts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui"
  },
  "author": "Tim Schumacher",
  "license": "MIT",
  "engines": {
    "node": ">=24.11.0 <27"
  },
  "packageManager": "npm@11.17.0",
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/luxon": "3.7.4",
    "@types/mdast": "4.0.4",
    "@types/node": "24.12.0",
    "@vitest/coverage-v8": "4.1.10",
    "@vitest/ui": "4.1.10",
    "eslint": "10.8.1",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.11.0",
    "pino-pretty": "13.1.3",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.67.0",
    "vitest": "4.1.10"
  },
  "dependencies": {
    "arktype": "2.2.3",
    "luxon": "3.7.2",
    "matrix-bot-sdk": "0.8.0",
    "node-ical": "0.27.1",
    "pino": "10.3.1",
    "rehype-stringify": "10.0.1",
    "remark-parse": "11.0.0",
    "remark-rehype": "11.1.2",
    "remark-stringify": "11.0.0",
    "telegraf": "4.16.3",
    "tsdav": "2.3.1",
    "unified": "11.0.5",
    "unist-util-visit": "5.1.0"
  }
}
