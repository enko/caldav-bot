{
  "name": "caldav-telegram-bot-v2",
  "version": "0.1.0",
  "description": "A bot that posts forthcomming events to a telegram channel",
  "main": "dist/main.mjs",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "start": "tsx src/main.mts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui"
  },
  "author": "Tim Schumacher",
  "license": "MIT",
  "engines": {
    "node": ">=24.11.0 <27"
  },
  "packageManager": "npm@11.17.0",
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/ical": "0.8.3",
    "@types/lodash": "4.14.202",
    "@types/luxon": "3.7.4",
    "@types/mdast": "4.0.4",
    "@types/node": "24.12.0",
    "@vitest/coverage-v8": "4.1.10",
    "@vitest/ui": "4.1.10",
    "eslint": "10.8.1",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.11.0",
    "prettier": "3.9.6",
    "tsx": "4.7.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.67.0",
    "vitest": "4.1.10"
  },
  "dependencies": {
    "@freshgum/typedi": "0.7.1",
    "@matrix-org/olm": "3.2.15",
    "app-root-path": "3.1.0",
    "dotenv": "16.3.1",
    "ical": "0.8.0",
    "ical.js": "1.5.0",
    "lodash": "4.17.21",
    "luxon": "3.4.4",
    "matrix-bot-sdk": "0.7.0",
    "pino": "8.17.2",
    "pino-pretty": "10.3.1",
    "reflect-metadata": "0.2.1",
    "rehype-stringify": "10.0.0",
    "remark": "15.0.1",
    "remark-parse": "11.0.0",
    "remark-rehype": "11.1.0",
    "remark-stringify": "11.0.0",
    "telegraf": "4.15.3",
    "tsdav": "2.0.7",
    "unified": "11.0.4",
    "unist-util-visit": "5.0.0"
  }
}
