# Days to look ahead. Optional, defaults to 14.
CALENDAR_DURATION=14

# IANA zone the digest is rendered in. Optional; unset, the process zone applies
# (TZ, else the host - UTC in a container). A misspelled zone fails at startup.
# CALENDAR_TIMEZONE=Europe/Berlin

# Pino level: trace | debug | info | warn | error | fatal. Optional, defaults to
# info. Event payloads are logged at debug.
# LOG_LEVEL=info

# Target channel/room. Telegram: numeric chat id. Matrix: room id (!room:server).
CHANNEL_ID=

CALDAV_BASE_URL=https://cloud.example.com/remote.php/dav
CALDAV_CALENDARS=Calendar A|Calendar B
CALDAV_USER_NAME=
CALDAV_USER_PASSWORD=
# nextcloud | monica
CALDAV_CALENDAR_PROVIDER=nextcloud

# telegram | matrix
MESSENGER=telegram

# MESSENGER=telegram
TELEGRAM_BOT_TOKEN=

# MESSENGER=matrix
MATRIX_HOME_SERVER_URL=https://matrix.example.com
MATRIX_USER_ID=@caldav-bot:example.com
MATRIX_USER_PASSWORD=
MATRIX_SETTINGS_FILE=./settings.json
MATRIX_CRYPTO_DIRECTORY=./crypto
