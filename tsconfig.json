{
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "./dist",
    // strict lands in its own commit; TypeScript 6 defaults it to true.
    "strict": false,
    "target": "es2024",
    "lib": ["es2024"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "types": ["node"],
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "declaration": false,
    "sourceMap": true,
    "skipLibCheck": true
  },
  "include": ["src/**/*.mts"]
}
